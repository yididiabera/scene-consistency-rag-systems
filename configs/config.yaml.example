# Example override configuration for the Scene Consistency RAG System.
# Copy this file to `configs/config.yaml` and adjust values as needed.

# Paths
# data_dir: "data"
# schemas_dir: "schemas"
# chroma_store_path: "data/chroma_store"
# bm25_index_path: "data/bm25_index.pkl"
# embed_cache_dir: "data/embed_cache"

# Model configuration
# clip_model: "ViT-B/32"
# reranker_model: "cross-encoder/ms-marco-MiniLM-L-6-v2"
# reranker_batch_size: 32

# Retrieval configuration
# bm25_weight: 0.3
# top_k_retrieval: 20
# top_k_rerank: 5

# Chunking configuration
# chunk_size: 500
# chunk_overlap: 50
